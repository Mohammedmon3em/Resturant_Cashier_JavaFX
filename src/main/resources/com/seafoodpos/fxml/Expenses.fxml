<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.seafoodpos.controller.ExpensesController" spacing="14">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Expenses Management" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Add Depreciation / إضافة إهلاك" onAction="#handleAddDepreciation" styleClass="btn-warning"/>
        <Button text="Add Expense / إضافة مصروف" onAction="#handleAddExpense" styleClass="btn-primary"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colName" text="Expense Name" prefWidth="300"/>
            <TableColumn fx:id="colAmount" text="Amount" prefWidth="150"/>
            <TableColumn fx:id="colDate" text="Date" prefWidth="200"/>
        </columns>
    </TableView>
</VBox>
